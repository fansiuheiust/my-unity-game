  floorPerks:
  - id: RoomSkipper
    name: Room Skipper
    rawDescription: The floor will consist of {Room Reduction} less rooms, with there
      being only the start room and final room in the final tier.
    <UseDefaultCoinType>k__BackingField: 1
    coinType: 0
    stats:
    - type: 2
      name: Room Reduction
      values:
      - 10
      - 25
      - 50
      - 100
