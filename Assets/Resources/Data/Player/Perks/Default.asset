    - tier: 0
      value: 5
    - tier: 0
      value: 6
    - tier: 0
      value: 8
    - tier: 0
      value: 10
  - id: Scavenge
    name: Scavenge
    rawDescription: Gain {Coin Per Skip} coin(s) per skipped room, can only trigger
