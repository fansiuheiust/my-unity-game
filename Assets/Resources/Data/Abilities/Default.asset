  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd47fdd96e0818e4e92048e79900e3ae, type: 3}
  m_Name: Default
  m_EditorClassIdentifier: Assembly-CSharp::Progression.Balance.AbilityData
  abilities:
  - id: Speedy
    name: Speedy
    rawDescription: Gives you {Speed Boost} more speed for {Duration} seconds.
    cooldown: 10
    manaCost: 0
    triggerKey: 4
    attributes:
    - name: Speed Boost
      type: 2
      value: 50
    - name: Duration
      type: 1
      value: 4
  - id: ShellSmash
    name: Shell Smash
    rawDescription: When your HP falls below {HP Threshold}, increases your atk by
      {Attack Increase}, walk speed by {Walk Speed Increase}, attack speed by {Attack
      Speed Increase}, but reduces your defence by {Defence Reduction}. Can only
      be triggered once.
    cooldown: 0
    manaCost: 0
    triggerKey: 5
    attributes:
    - name: HP Threshold
      type: 2
      value: 50
    - name: Attack Increase
      type: 2
      value: 50
    - name: Walk Speed Increase
      type: 2
      value: 15
    - name: Attack Speed Increase
      type: 2
      value: 10
    - name: Defence Reduction
      type: 2
      value: 67
  - id: ClawFling
    name: Claw Fling
    rawDescription: Surrounds yourself with {Num Claws} claws in 360 degrees, then
      flings them away from you, each dealing {Claw Damage} of your attack.
    cooldown: 5
    manaCost: 20
    triggerKey: 4
    attributes:
    - name: Num Claws
      type: 0
      value: 24
    - name: Claw Damage
      type: 2
      value: 200
    - name: Claw Speed
      type: 1
      value: 60
  perkAbilities:
